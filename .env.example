# Server-only configuration. Nothing here may be prefixed with NEXT_PUBLIC_:
# anything public is compiled into the browser bundle and can be read by visitors.

# Any OpenAI-compatible /chat/completions endpoint (OpenAI, Azure OpenAI proxy,
# Moonshot, DeepSeek, Together, vLLM, ...).
ANALYSIS_API_KEY=
ANALYSIS_BASE_URL=https://api.openai.com/v1
ANALYSIS_MODEL=gpt-4o-mini

# Optional. Without a key the pipeline still runs on real captions: it segments,
# marks candidate moments from the text, and the UI says "captions only".
# OPENAI_API_KEY is also accepted as a fallback name.

# Optional shared cache (Upstash Redis REST API, no SDK required).
# Without it, analyses live in a per-instance LRU and expire on cold start.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. An existing agent endpoint forwarded from /api/assistant.
# The token is read on the server only.
COZE_ENDPOINT=
COZE_TOKEN=
